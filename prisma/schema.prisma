datasource db {
  provider = "postgresql"
}

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["driverAdapters"]
}

model Usuario {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  nombre       String
  rol          String
  area         String?
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())

  cotizacionesCreadas   Cotizacion[] @relation("CotCreadaPor")
  cotizacionesEliminadas Cotizacion[] @relation("CotEliminadaPor")
  setsCreados           SET[]        @relation("SETCreadoPor")
  informesAsignados     Informe[]    @relation("InformeAnalista")

  requerimientosCreados     Requerimiento[]       @relation("ReqCreadoPor")
  cotizacionesProvCreadas   CotizacionProveedor[] @relation("CotProvCreadaPor")
  cotizacionesProvAprobadas CotizacionProveedor[] @relation("CotProvAprobadaPor")
  ordenesCompraEmitidas     OrdenCompra[]         @relation("OCEmitidaPor")
  recepcionesRealizadas     Recepcion[]           @relation("RecepcionPor")
  devolucionesGestionadas   Devolucion[]          @relation("DevolucionPor")
  facturasRegistradas       Factura[]             @relation("FacturaPor")
  provisionesAprobadas      ProvisionPago[]       @relation("ProvisionPor")
  pagosAprobados            Pago[]                @relation("PagoPor")
  notificaciones            Notificacion[]
  cajaChicaGastos           CajaChicaGasto[]
  cajaChicaIngresos         CajaChicaIngreso[]
  mensajesEnviados          MensajeDM[]
  conversacionesA           ConversacionDM[]      @relation("ConvA")
  conversacionesB           ConversacionDM[]      @relation("ConvB")
  auditLogs                 AuditLog[]
  peticionesCreadas         PeticionEfectivo[]    @relation("PeticionSolicitante")
  peticionesAprobadas       PeticionEfectivo[]    @relation("PeticionAprobadaPor")
  facturasCliente           FacturaCliente[]      @relation("FacturaClientePor")
  solicitudesVacaciones     SolicitudVacaciones[] @relation("SolicitudVacPor")
  solicitudesVacAprobadas   SolicitudVacaciones[] @relation("SolicitudVacAprobadaPor")
  solicitudesVacComunicadas SolicitudVacaciones[] @relation("SolicitudVacComunicadaPor")
  aprobadoresVacaciones     UsuarioAprobadorVacaciones[] @relation("VacSolicitante")
  aprobacionesVacACargo     UsuarioAprobadorVacaciones[] @relation("VacAprobador")
  empleado                  Empleado?
  historialOC               OrdenCompraHistorial[]       @relation("OCHistorialUsuario")
  movimientosInventario     InventarioMovimiento[]       @relation("InventarioMovimientoUsuario")
  auditorias                Auditoria[]                  @relation("AuditoriaCreadaPor")
}

/// Matriz N:M de aprobadores de vacaciones.
/// Un solicitante puede tener varios aprobadores (cualquiera de ellos
/// puede aprobar). Un aprobador puede tener varios solicitantes a cargo.
model UsuarioAprobadorVacaciones {
  id            String  @id @default(cuid())
  solicitanteId String
  aprobadorId   String
  solicitante   Usuario @relation("VacSolicitante", fields: [solicitanteId], references: [id], onDelete: Cascade)
  aprobador     Usuario @relation("VacAprobador",   fields: [aprobadorId],   references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  @@unique([solicitanteId, aprobadorId])
  @@index([aprobadorId])
}

model ConversacionDM {
  id         String      @id @default(cuid())
  usuarioAId String
  usuarioBId String
  usuarioA   Usuario     @relation("ConvA", fields: [usuarioAId], references: [id], onDelete: Cascade)
  usuarioB   Usuario     @relation("ConvB", fields: [usuarioBId], references: [id], onDelete: Cascade)
  mensajes   MensajeDM[]
  createdAt  DateTime    @default(now())

  @@unique([usuarioAId, usuarioBId])
}

model MensajeDM {
  id             String         @id @default(cuid())
  conversacionId String
  conversacion   ConversacionDM @relation(fields: [conversacionId], references: [id], onDelete: Cascade)
  autorId        String
  autor          Usuario        @relation(fields: [autorId], references: [id])
  contenido      String
  archivoUrl     String?
  archivoNombre  String?
  archivoTipo    String?
  createdAt      DateTime       @default(now())
}

model CajaChicaGasto {
  id              String     @id @default(cuid())
  fecha           DateTime   @default(now())
  concepto        String
  monto           Float
  moneda          String     @default("PEN")
  categoria       String?
  proveedorId     String?
  proveedor       Proveedor? @relation(fields: [proveedorId], references: [id])
  proveedorNombre String?
  proveedorRuc    String?
  numeroFactura   String?
  comprobante     String?
  notas           String?
  creadoPorId     String
  creadoPor       Usuario    @relation(fields: [creadoPorId], references: [id])
  createdAt       DateTime   @default(now())

  // Campos contables adicionales
  caja             String?   @default("102102 CAJA CHICA DE CETOX")
  numComprobante   String?
  tipoDocumento    String?
  serie            String?
  numero           String?
  fechaEmision     DateTime?
  fechaVencimiento DateTime?
  condicion        String?
  tipoCambio       Float?
  glosa            String?
  centroCosto      String?
  ctaGasto         String?
  afecto           Boolean   @default(false)
}

model CajaChicaIngreso {
  id          String   @id @default(cuid())
  fecha       DateTime @default(now())
  monto       Float
  moneda      String   @default("PEN")
  descripcion String
  creadoPorId String
  creadoPor   Usuario  @relation(fields: [creadoPorId], references: [id])
  createdAt   DateTime @default(now())
}

model Notificacion {
  id        String   @id @default(cuid())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tipo      String   // INFORME_EMITIDO
  titulo    String
  mensaje   String
  enlace    String?
  leida     Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Cliente {
  id            String   @id @default(cuid())
  razonSocial   String
  ruc           String   @unique
  direccion     String
  pais          String   @default("PE")
  contacto      String?
  email         String?
  telefono      String?
  activo        Boolean  @default(true)
  createdAt     DateTime @default(now())

  cotizaciones     Cotizacion[]
  sets             SET[]
  facturasCliente  FacturaCliente[]
}

model Ensayo {
  id                String   @id @default(cuid())
  codigo            String   @unique
  nombre            String
  prefijoInforme    String
  area              String
  metodoNorma       String
  costoUSD          Float?
  costoPEN          Float?
  tiempoEntregaDias Int
  acreditadoINACAL  Boolean  @default(false)
  tercerizado       Boolean  @default(false)
  tipoMuestra       String?
  plantillaWord     String?
  alias             String?
  activo            Boolean  @default(true)

  cotizacionItems CotizacionItem[]
  odaItems        ODAItem[]
}

model Cotizacion {
  id               String   @id @default(cuid())
  numero           Int
  anio             Int
  sufijo           String   @default("")
  cotizacionPadre  String?
  fechaEmision     DateTime @default(now())
  vigenciaHasta    DateTime
  moneda           String   @default("USD")
  modalidadPago    String   @default("ANTICIPO_50_50")
  tipo             String   @default("NORMAL")  // NORMAL | ABIERTA
  clienteId        String
  cliente          Cliente  @relation(fields: [clienteId], references: [id])
  estado           String   @default("BORRADOR")
  observaciones    String?
  contactoNombre   String?
  contactoEmail    String?
  contactoTelefono String?
  contactoRuc      String?
  formaContacto    String?
  fechaContacto    String?
  horaContacto     String?
  paisOrigen       String?
  creadoPorId      String
  creadoPor        Usuario  @relation("CotCreadaPor", fields: [creadoPorId], references: [id])
  subtotal         Float    @default(0)
  igv              Float    @default(0)
  total            Float    @default(0)
  deletedAt        DateTime?
  deletedById      String?
  deletedBy        Usuario?  @relation("CotEliminadaPor", fields: [deletedById], references: [id])
  informeEnviado   Boolean  @default(false)
  items            CotizacionItem[]
  muestras         CotizacionMuestra[]
  sets             SET[]
  facturasCliente  FacturaCliente[]

  @@unique([numero, anio, sufijo])
}

model CotizacionMuestra {
  id           String           @id @default(cuid())
  cotizacionId String
  cotizacion   Cotizacion       @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)
  nombre       String
  orden        Int              @default(0)
  indicacionQ  String?          // Indicaciones para laboratorio de Química
  indicacionB  String?          // Indicaciones para laboratorio de Biología
  indicacionM  String?          // Indicaciones para laboratorio de Microbiología
  items        CotizacionItem[]
  sets         SET[]
}

model CotizacionItem {
  id                String             @id @default(cuid())
  cotizacionId      String
  cotizacion        Cotizacion         @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)
  muestraId         String?
  muestra           CotizacionMuestra? @relation(fields: [muestraId], references: [id])
  ensayoId          String
  ensayo            Ensayo             @relation(fields: [ensayoId], references: [id])
  costo             Float
  tiempoEntregaDias Int
}

model SET {
  id                String     @id @default(cuid())
  numero            Int
  anio              Int
  cotizacionId      String?
  cotizacion        Cotizacion? @relation(fields: [cotizacionId], references: [id])
  muestraId         String?
  muestra           CotizacionMuestra? @relation(fields: [muestraId], references: [id])
  clienteId         String
  cliente           Cliente    @relation(fields: [clienteId], references: [id])
  motivoCero        String?
  fechaIngreso      DateTime   @default(now())
  nombreComercial   String?
  ingredienteActivo String?
  formulacion       String?
  numeroLote        String?
  fechaFabricacion  DateTime?
  fechaVencimiento  DateTime?
  pesoVolumen       String?
  tipoMuestra       String?
  codigoMuestra     String     @unique
  fotoUrl           String?
  observaciones     String?
  estado            String     @default("EMITIDA")
  creadoPorId       String
  creadoPor         Usuario    @relation("SETCreadoPor", fields: [creadoPorId], references: [id])
  odas              ODA[]
  cargoEntrega      CargoEntrega?
  nombrePaciente         String?
  edadPaciente           String?
  ingresoMuestra         String?
  ingresoMuestraOtro     String?
  numeroMuestras         String?
  devolucionMuestra      String?
  condicionesAmbientales String?
  procedenciaDescripcion String?
  otraIndicacion         String?  // legacy — campo único anterior
  otraIndicacionQ        String?  // Química
  otraIndicacionB        String?  // Biología
  otraIndicacionM        String?  // Microbiología
  tipoEnvase             String?
  materialEnvase         String?
  etiquetaEnvase         String?
  seguridadEnvase        String?

  @@unique([numero, anio])
}

model ODA {
  id                     String    @id @default(cuid())
  numero                 Int
  anio                   Int
  setId                  String
  set                    SET       @relation(fields: [setId], references: [id])
  area                   String
  fechaRecepcion         DateTime?
  fechaInicioEjecucion   DateTime?
  fechaEntregaCompromiso DateTime
  estado                 String    @default("EMITIDA")
  revisado               Boolean   @default(false)
  fechaRevisado          DateTime?
  edadPaciente           String?
  items                  ODAItem[]
  informe                Informe?

  @@unique([numero, anio])
}

model ODAItem {
  id                     String   @id @default(cuid())
  odaId                  String
  oda                    ODA      @relation(fields: [odaId], references: [id], onDelete: Cascade)
  ensayoId               String
  ensayo                 Ensayo   @relation(fields: [ensayoId], references: [id])
  costo                  Float    @default(0)
  tiempoEntregaDias      Int      @default(0)
  fechaEntregaCompromiso DateTime
}

model Informe {
  id             String    @id @default(cuid())
  numero         Int
  anio           Int
  prefijo        String
  odaId          String    @unique
  oda            ODA       @relation(fields: [odaId], references: [id])
  analistaId     String
  analista       Usuario   @relation("InformeAnalista", fields: [analistaId], references: [id])
  resultadoTexto    String?
  resultadoImagenes String  @default("[]")
  resultadoArchivos String  @default("[]")
  archivoDocx              String?
  archivoPdf               String?
  archivoFirmadoGerencia   String?
  estado                   String    @default("BORRADOR")
  fechaEnvioResultados     DateTime?
  observacionesCalidad     String?
  firmaCalidad          DateTime?
  firmaGerencia         DateTime?
  certificadoQR         Certificado?
  createdAt             DateTime  @default(now())

  @@unique([numero, anio, prefijo])
}

model Certificado {
  id           String   @id @default(cuid())
  codigo       String   @unique
  informeId    String   @unique
  informe      Informe  @relation(fields: [informeId], references: [id])
  clave        String
  qrUrl        String
  fechaEmision DateTime @default(now())
}

model CargoEntrega {
  id             String    @id @default(cuid())
  numero         Int
  anio           Int
  setId          String    @unique
  set            SET       @relation(fields: [setId], references: [id])
  recibidoPor    String?
  dniRecibe      String?
  fechaRecepcion DateTime?
  firmaUrl       String?

  @@unique([numero, anio])
}

model Proveedor {
  id             String   @id @default(cuid())
  razonSocial    String
  ruc            String?  @unique
  especialidad   String?
  direccion      String?
  contacto       String?
  telefono       String?
  telefono2      String?
  telefono3      String?
  email          String?
  email2         String?
  email3         String?
  cuentaBancaria  String?
  productosTexto  String? // comma-separated product names this supplier sells
  activo          Boolean  @default(true)
  createdAt       DateTime @default(now())

  cotizacionesProveedor CotizacionProveedor[]
  ordenesCompra         OrdenCompra[]
  cajaChicaGastos       CajaChicaGasto[]
}

model Requerimiento {
  id              String    @id @default(cuid())
  numero          Int
  anio            Int
  areaSolicitante String
  descripcion     String
  justificacion   String?
  urgencia        String    @default("NORMAL")
  estado          String    @default("BORRADOR")
  fechaRequerida  DateTime?
  creadoPorId     String
  creadoPor       Usuario   @relation("ReqCreadoPor", fields: [creadoPorId], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  items                 RequerimientoItem[]
  cotizacionesProveedor CotizacionProveedor[]
  ordenesCompra         OrdenCompra[]

  @@unique([numero, anio])
}

model RequerimientoItem {
  id               String        @id @default(cuid())
  requerimientoId  String
  requerimiento    Requerimiento @relation(fields: [requerimientoId], references: [id], onDelete: Cascade)
  descripcion      String
  cantidad         Float
  unidad           String
  especificaciones String?
  orden            Int           @default(0)
}

model CotizacionProveedor {
  id               String        @id @default(cuid())
  numero           Int
  anio             Int
  requerimientoId  String
  requerimiento    Requerimiento @relation(fields: [requerimientoId], references: [id])
  proveedorId      String
  proveedor        Proveedor     @relation(fields: [proveedorId], references: [id])
  moneda           String        @default("PEN")
  subtotal         Float         @default(0)
  igv              Float         @default(0)
  total            Float         @default(0)
  plazoEntregaDias Int?
  condicionesPago  String?
  validezDias      Int?
  archivoUrl       String?
  estado           String        @default("BORRADOR")
  observaciones    String?
  aprobadoPorId    String?
  aprobadoPor      Usuario?      @relation("CotProvAprobadaPor", fields: [aprobadoPorId], references: [id])
  fechaAprobacion  DateTime?
  motivoRechazo    String?
  creadoPorId      String
  creadoPor        Usuario       @relation("CotProvCreadaPor", fields: [creadoPorId], references: [id])
  createdAt        DateTime      @default(now())

  items         CotizacionProveedorItem[]
  ordenesCompra OrdenCompraCotizacion[]

  @@unique([numero, anio])
}

model CotizacionProveedorItem {
  id                    String              @id @default(cuid())
  cotizacionProveedorId String
  cotizacionProveedor   CotizacionProveedor @relation(fields: [cotizacionProveedorId], references: [id], onDelete: Cascade)
  descripcion           String
  cantidad              Float
  unidad                String
  precioUnitario        Float
  subtotal              Float
  orden                 Int                 @default(0)
}

model OrdenCompra {
  id                         String               @id @default(cuid())
  numero                     Int
  anio                       Int
  requerimientoId            String
  requerimiento              Requerimiento        @relation(fields: [requerimientoId], references: [id])
  proveedorId                String
  proveedor                  Proveedor            @relation(fields: [proveedorId], references: [id])
  moneda                     String               @default("PEN")
  subtotal                   Float                @default(0)
  igv                        Float                @default(0)
  total                      Float                @default(0)
  condicionesPago            String?
  lugarEntrega               String?
  fechaEntregaEstimada       DateTime?
  estado                     String               @default("EMITIDA")
  observaciones              String?
  archivoPdfUrl              String?
  facturaOcUrl               String?
  comprobantePagoUrl         String?
  fechaConfirmacionProveedor DateTime?
  emitidoPorId               String
  emitidoPor                 Usuario              @relation("OCEmitidaPor", fields: [emitidoPorId], references: [id])
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt

  items                 OrdenCompraItem[]
  recepciones           Recepcion[]
  facturas              Factura[]
  cotizacionesProveedor OrdenCompraCotizacion[]
  historial             OrdenCompraHistorial[]

  @@unique([numero, anio])
}

model OrdenCompraCotizacion {
  ordenCompraId         String
  ordenCompra           OrdenCompra         @relation(fields: [ordenCompraId], references: [id], onDelete: Cascade)
  cotizacionProveedorId String
  cotizacionProveedor   CotizacionProveedor @relation(fields: [cotizacionProveedorId], references: [id])

  @@id([ordenCompraId, cotizacionProveedorId])
}

model OrdenCompraHistorial {
  id            String      @id @default(cuid())
  ordenCompraId String
  ordenCompra   OrdenCompra @relation(fields: [ordenCompraId], references: [id], onDelete: Cascade)
  usuarioId     String
  usuario       Usuario     @relation("OCHistorialUsuario", fields: [usuarioId], references: [id])
  descripcion   String
  createdAt     DateTime    @default(now())
}

model OrdenCompraItem {
  id               String      @id @default(cuid())
  ordenCompraId    String
  ordenCompra      OrdenCompra @relation(fields: [ordenCompraId], references: [id], onDelete: Cascade)
  descripcion      String
  cantidad         Float
  cantidadRecibida Float       @default(0)
  unidad           String
  precioUnitario   Float
  subtotal         Float
  orden            Int         @default(0)
  facturaUrl       String?
}

model Recepcion {
  id                   String      @id @default(cuid())
  numero               Int
  anio                 Int
  ordenCompraId        String
  ordenCompra          OrdenCompra @relation(fields: [ordenCompraId], references: [id])
  fechaRecepcion       DateTime    @default(now())
  recibidoPorId        String
  recibidoPor          Usuario     @relation("RecepcionPor", fields: [recibidoPorId], references: [id])
  estado               String      @default("PENDIENTE")
  observaciones        String?
  areaDestino          String?
  entregadoAlAreaFecha DateTime?
  entregadoAlAreaPor   String?
  conformeArea         Boolean?
  observacionesArea    String?
  documentoUrl         String?

  items        RecepcionItem[]
  devoluciones Devolucion[]

  @@unique([numero, anio])
}

model RecepcionItem {
  id               String    @id @default(cuid())
  recepcionId      String
  recepcion        Recepcion @relation(fields: [recepcionId], references: [id], onDelete: Cascade)
  descripcion      String
  cantidadEsperada Float
  cantidadRecibida Float
  unidad           String
  conforme         Boolean   @default(true)
  observacion      String?
}

model Devolucion {
  id              String     @id @default(cuid())
  numero          Int
  anio            Int
  recepcionId     String
  recepcion       Recepcion  @relation(fields: [recepcionId], references: [id])
  tipo            String     @default("TOTAL")
  motivo          String
  fechaDevolucion DateTime   @default(now())
  gestionadoPorId String
  gestionadoPor   Usuario    @relation("DevolucionPor", fields: [gestionadoPorId], references: [id])
  documentoUrl    String?
  estado          String     @default("PENDIENTE")

  items DevolucionItem[]

  @@unique([numero, anio])
}

model DevolucionItem {
  id           String     @id @default(cuid())
  devolucionId String
  devolucion   Devolucion @relation(fields: [devolucionId], references: [id], onDelete: Cascade)
  descripcion  String
  cantidad     Float
  unidad       String
  motivo       String?
}

model Factura {
  id               String      @id @default(cuid())
  serie            String?
  numero           String
  ordenCompraId    String
  ordenCompra      OrdenCompra @relation(fields: [ordenCompraId], references: [id])
  moneda           String      @default("PEN")
  subtotal         Float
  igv              Float
  total            Float
  fechaEmision     DateTime
  fechaVencimiento DateTime?
  estado           String      @default("REGISTRADA")
  archivoUrl       String?
  registradoPorId  String
  registradoPor    Usuario     @relation("FacturaPor", fields: [registradoPorId], references: [id])
  createdAt        DateTime    @default(now())

  provision ProvisionPago?
}

model ProvisionPago {
  id              String   @id @default(cuid())
  facturaId       String   @unique
  factura         Factura  @relation(fields: [facturaId], references: [id])
  monto           Float
  concepto        String?
  condicionPago   String   @default("CREDITO_30")
  aprobadoPorId   String
  aprobadoPor     Usuario  @relation("ProvisionPor", fields: [aprobadoPorId], references: [id])
  fechaAprobacion DateTime @default(now())
  observaciones   String?

  pago Pago?
}

model Pago {
  id                  String        @id @default(cuid())
  numero              Int
  anio                Int
  provisionId         String        @unique
  provision           ProvisionPago @relation(fields: [provisionId], references: [id])
  monto               Float
  moneda              String        @default("PEN")
  medioPago           String        @default("TRANSFERENCIA")
  fechaPago           DateTime
  referencia          String?
  estado              String        @default("PENDIENTE")
  aprobadoPorId       String
  aprobadoPor         Usuario       @relation("PagoPor", fields: [aprobadoPorId], references: [id])
  confirmadoProveedor Boolean       @default(false)
  fechaConfirmacion   DateTime?
  voucherUrl          String?
  createdAt           DateTime      @default(now())

  @@unique([numero, anio])
}

model Empleado {
  id           String    @id @default(cuid())
  dni          String    @unique
  nombre       String
  tipoContrato String
  fechaIngreso DateTime
  finContrato  DateTime?
  cargo        String?
  area         String?
  notas        String?
  funciones    String?
  activo       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // 1:1 con Usuario para poder afectar VacacionBalance al aprobarse vacaciones.
  usuarioId    String?   @unique
  usuario      Usuario?  @relation(fields: [usuarioId], references: [id])

  vacacion    VacacionBalance?
  documentos  DocumentoEmpleado[]
  asistencias Asistencia[]
}

model Asistencia {
  id         String    @id @default(cuid())
  empleadoId String?
  empleado   Empleado? @relation(fields: [empleadoId], references: [id])
  zkUserId   String
  zkNombre   String
  timestamp  DateTime
  tipo       Int       // 0=entrada 1=salida 4=extra-entrada 5=extra-salida
  createdAt  DateTime  @default(now())

  @@unique([zkUserId, timestamp])
}

model DocumentoEmpleado {
  id             String   @id @default(cuid())
  empleadoId     String
  empleado       Empleado @relation(fields: [empleadoId], references: [id], onDelete: Cascade)
  nombre         String
  tipo           String?
  archivoUrl     String
  archivoTipo    String?
  tamanio        Int?
  visibleCalidad Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([empleadoId])
}

model VacacionBalance {
  id                    String   @id @default(cuid())
  empleadoId            String   @unique
  empleado              Empleado @relation(fields: [empleadoId], references: [id], onDelete: Cascade)
  diasAtrasados         Int      @default(0)
  diasReglamentarios    Int      @default(0)
  adelantadasTomadas    Int      @default(0)
  adelantadasPendientes Int      @default(0)
  updatedAt             DateTime @updatedAt
}

model Equipo {
  id             String        @id @default(cuid())
  codigo         String        @unique
  nombre         String
  area           String?       // B=Biología, Q=Química, M=Microbiología, AD, CAL
  categoria      String        @default("GENERAL") // GENERAL | TERMOHIGROMETRO | VIDRIO
  ultimoServicio DateTime?
  notas          String?
  activo         Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tareas TareaEquipo[]
}

model TareaEquipo {
  id         String    @id @default(cuid())
  equipoId   String
  equipo     Equipo    @relation(fields: [equipoId], references: [id], onDelete: Cascade)
  tipo       String    // PREVENTIVO | CALIBRACION | VERIFICACION
  mes        Int       // 1-12
  anio       Int
  completado Boolean   @default(false)
  fechaReal  DateTime?
  nota       String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([equipoId])
  @@index([mes, anio])
}

model InventarioItem {
  id          String   @id @default(cuid())
  codOrden    String?  @unique
  descripcion String
  categoria   String?
  unidad      String?
  stock       Float    @default(0)
  stockMinimo Float?
  activo      Boolean  @default(true)
  notas       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  movimientos InventarioMovimiento[]
}

model InventarioMovimiento {
  id               String         @id @default(cuid())
  inventarioItemId String
  inventarioItem   InventarioItem @relation(fields: [inventarioItemId], references: [id], onDelete: Cascade)
  tipo             String         // ENTRADA | SALIDA | AJUSTE
  cantidad         Float
  stockAnterior    Float
  stockNuevo       Float
  areaDestino      String?
  descripcion      String?
  usuarioId        String
  usuario          Usuario        @relation("InventarioMovimientoUsuario", fields: [usuarioId], references: [id])
  createdAt        DateTime       @default(now())
}

// ── Factura al Cliente (generada desde Cotización) ───────────────────────────

model FacturaCliente {
  id               String     @id @default(cuid())
  serie            String     @default("F001")
  numero           Int
  anio             Int
  cotizacionId     String
  cotizacion       Cotizacion @relation(fields: [cotizacionId], references: [id])
  clienteId        String
  cliente          Cliente    @relation(fields: [clienteId], references: [id])
  moneda           String     @default("USD")
  subtotal         Float
  igv              Float
  total            Float
  fechaEmision     DateTime   @default(now())
  fechaVencimiento DateTime?
  estado           String     @default("PENDIENTE")  // PENDIENTE | PAGADA | ANULADA
  itemsJson        String     @default("[]")         // JSON: [{nombre, muestra?, costo}]
  notas            String?
  archivoUrl       String?
  // ── Registro de cobranza ──────────────────────────────────────────────────
  concepto              String?   // descripción libre (ej. "De veterquimica peru s")
  numeroOperacion       String?   // Nº operación bancaria
  porcentajeDetraccion  Int?      // % detracción: 100, 88, etc. null = no aplica
  sujetaDetraccion      Boolean?  // SI / NO
  montoIngresado        Float?    // monto $ efectivamente ingresado
  adelantoSet           Float?    // adelanto al SET
  saldoSet              Float?    // saldo pendiente del SET
  creadoPorId      String
  creadoPor        Usuario    @relation("FacturaClientePor", fields: [creadoPorId], references: [id])
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@unique([numero, anio, serie])
}

// ── Petición de Efectivo ──────────────────────────────────────────────────────

model PeticionEfectivo {
  id              String    @id @default(cuid())
  numero          Int
  anio            Int
  solicitanteId   String
  solicitante     Usuario   @relation("PeticionSolicitante",  fields: [solicitanteId], references: [id])
  concepto        String
  montoSolicitado Float
  moneda          String    @default("PEN")
  justificacion   String?
  estado          String    @default("PENDIENTE")
  montoAprobado   Float?
  motivoRechazo   String?
  aprobadaPorId   String?
  aprobadaPor     Usuario?  @relation("PeticionAprobadaPor", fields: [aprobadaPorId], references: [id])
  fechaResolucion DateTime?
  ingresoId       String?   @unique
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([numero, anio])
}

// ── Solicitud de Vacaciones ───────────────────────────────────────────────────

model SolicitudVacaciones {
  id                String   @id @default(cuid())
  usuarioId         String
  usuario           Usuario  @relation("SolicitudVacPor", fields: [usuarioId], references: [id])
  cargo             String   // cargo al momento de la solicitud
  departamento      String   // área / departamento
  jefeInmediato     String   // nombre del jefe inmediato superior (denormalizado)
  diasSolicitados   String   // JSON: ["2026-04-24", "2026-04-27", ...]
  tipoVacaciones    String   // REGLAMENTARIA | ATRASADA | ADELANTADA
  tipoLicencia      String   // CON_GOCE | SIN_GOCE | MOTIVOS_PERSONALES | OTROS
  personaDelegada   String?
  observaciones     String?
  // PENDIENTE → APROBADA (jefe) → COMUNICADA (Yahaida) ; o RECHAZADA en cualquier paso
  estado            String   @default("PENDIENTE")
  fechaSolicitud    DateTime @default(now())
  fechaAutorizacion DateTime?
  fechaAprobacion   DateTime?
  fechaComunicacion DateTime?
  aprobadoPorId     String?
  aprobadoPor       Usuario? @relation("SolicitudVacAprobadaPor",   fields: [aprobadoPorId],   references: [id])
  comunicadoPorId   String?
  comunicadoPor     Usuario? @relation("SolicitudVacComunicadaPor", fields: [comunicadoPorId], references: [id])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([usuarioId])
  @@index([estado])
}

// ── Audit Log ─────────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  usuarioId  String?
  usuario    Usuario? @relation(fields: [usuarioId], references: [id])
  accion     String   // CREATE | UPDATE | DELETE
  entidad    String   // Cotizacion | SET | Informe | etc.
  entidadId  String
  detalle    String?  // JSON string con {campo, antes, despues}
  ip         String?
  createdAt  DateTime @default(now())

  @@index([usuarioId])
  @@index([entidad, entidadId])
  @@index([createdAt])
}

model Auditoria {
  id          String               @id @default(cuid())
  codigo      String               @unique
  fecha       DateTime
  descripcion String?
  creadoPorId String
  creadoPor   Usuario              @relation("AuditoriaCreadaPor", fields: [creadoPorId], references: [id])
  createdAt   DateTime             @default(now())
  documentos  AuditoriaDocumento[]
}

model AuditoriaDocumento {
  id          String    @id @default(cuid())
  auditoriaId String
  auditoria   Auditoria @relation(fields: [auditoriaId], references: [id], onDelete: Cascade)
  nombre      String
  archivoUrl  String
  createdAt   DateTime  @default(now())
}
